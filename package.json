{
  "name": "@reflex/layers",
  "version": "0.9.9",
  "author": "Mathias Müller",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4302",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:electron": "ng build --base-href ./ && electron .",
    "build:electron-win": "ng build --base-href ./ && electron-builder build --win"
  },
  "build": {
    "appId": "reflex.layers",
    "productName": "ReFlex Layers",
    "copyright": "Copyright © 2023-2026 HTW Dresden",
    "buildVersion": "0.9.9",
    "files": [
      "main.js",
      "dist/**/*"
    ],
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "icon": "src/assets/icon/app_icon.png"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.11",
    "@angular/common": "^17.3.11",
    "@angular/compiler": "^17.3.11",
    "@angular/core": "^17.3.11",
    "@angular/forms": "^17.3.11",
    "@angular/platform-browser": "^17.3.11",
    "@angular/platform-browser-dynamic": "^17.3.11",
    "@angular/router": "^17.3.11",
    "@microsoft/signalr": "^7.0.14",
    "@types/electron": "^1.6.10",
    "electron-log": "^5.1.5",
    "three": "^0.165.0",
    "tslib": "^2.6.3",
    "zone.js": "~0.14.7"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.8",
    "@angular/cli": "^17.3.8",
    "@angular/compiler-cli": "^17.3.11",
    "@types/jasmine": "^5.1.4",
    "@types/node": "^20.14.2",
    "@types/three": "^0.165.0",
    "electron": "^22.1.0",
    "electron-builder": "^24.13.3",
    "jasmine-core": "^5.1.2",
    "karma": "^6.4.3",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "rxjs": "^7.8.1",
    "typescript": "~5.4.5"
  }
}
